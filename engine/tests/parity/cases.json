{
  "_doc": "M1 parity cases. Every case starts from examples/hwr010/InputFile (beam.txt, input.txt), applies the key edits, writes lattice.txt verbatim and runs the engine with field maps read from examples/hwr010/InputFile. 'common_input' is applied to every case.",
  "common_input": {"spacecharge": 0},
  "reference_omp_threads": 12,
  "cases": [
    {"name": "G0_generate", "reference_only": true,
     "beam": {"randomseed": 12345},
     "lattice": ["start", "drift 0.05 0.02 0", "end"],
     "export": {"inData.dst": "data/hwr010_seed12345.dst"}},

    {"name": "S1_single_onaxis",
     "beam": {"particlenumber": 1},
     "lattice": ["start", "drift 0.05 0.02 0",
                 "field 0.21 0.02 0 1 162.5e6 -33 1.36 -1.36 efield",
                 "drift 0.05 0.02 0", "end"]},

    {"name": "S2a_single_offaxis_hwr_sol",
     "beam": {"particlenumber": 1, "displacepos": "1 0 0", "displacedpos": "300 200 0"},
     "lattice": ["start", "drift 0.05 0.02 0",
                 "field 0.21 0.02 0 1 162.5e6 -33 1.36 -1.36 hwr010",
                 "drift 0.05 0.02 0",
                 "field 0.35 0.02 0 3 0 0 1 1 sol",
                 "drift 0.05 0.02 0", "end"]},

    {"name": "S2b_single_offaxis_neg",
     "beam": {"particlenumber": 1, "displacepos": "-1 0.5 0", "displacedpos": "-200 100 0"},
     "lattice": ["start", "drift 0.05 0.02 0",
                 "field 0.21 0.02 0 1 162.5e6 -33 1.36 -1.36 hwr010",
                 "drift 0.05 0.02 0",
                 "field 0.35 0.02 0 3 0 0 1 1 sol",
                 "drift 0.05 0.02 0", "end"]},

    {"name": "S3a_two_cav_v0_v0",
     "beam": {"particlenumber": 1},
     "lattice": ["start",
                 "field 0.21 0.02 0 1 162.5e6 -33 1.36 -1.36 efield",
                 "drift 0.05 0.02 0",
                 "field 0.21 0.02 0 1 162.5e6 -33 1.36 -1.36 efield", "end"]},

    {"name": "S3b_two_cav_v2_v0",
     "beam": {"particlenumber": 1},
     "lattice": ["start",
                 "field 0.21 0.02 2 1 162.5e6 0 1.36 -1.36 efield",
