# Engine source hash (avas_engine_version(), avas_engine_info(), the build stamp of the prebuilt
# libraries).  The same algorithm is avas.engines.engine_source_hash() in Python; keep them equal.
#
# Files: engine/CMakeLists.txt, everything under engine/include/ and engine/src/, and the source files
# (.h .hpp .c .cc .cpp .cu .cuh .mm .metal .inc) under engine/third_party/; names starting with "." are
# skipped.  Sorted by the path relative to engine/ ("/" separated); in every file CRLF is replaced by LF.
#   hash = SHA-256( concatenation of "<relative path>\n<SHA-256 hex of the file>\n" )
#
# Included by CMakeLists.txt for avas_hashed_files(); run as a script it writes the header:
#   cmake -DROOT=<engine dir> -DOUT=<header> -P source_hash.cmake

# Script mode (cmake -P) starts with every policy unset: CMake 3.x would read IN_LIST as a plain word
# (CMake 4 no longer has the old behaviour).  Policies are recorded when a function is defined.
cmake_policy(SET CMP0057 NEW)

set(AVAS_THIRD_PARTY_SOURCE_EXT ".h;.hpp;.c;.cc;.cpp;.cu;.cuh;.mm;.metal;.inc")

# Absolute paths of the hashed files, sorted by their relative path.
function(avas_hashed_files root out_var)
  set(glob_args "")
  if(NOT CMAKE_SCRIPT_MODE_FILE)
    set(glob_args CONFIGURE_DEPENDS)
  endif()
  file(GLOB_RECURSE inc LIST_DIRECTORIES false RELATIVE "${root}" ${glob_args} "${root}/include/*")
  file(GLOB_RECURSE src LIST_DIRECTORIES false RELATIVE "${root}" ${glob_args} "${root}/src/*")
  file(GLOB_RECURSE tp LIST_DIRECTORIES false RELATIVE "${root}" ${glob_args} "${root}/third_party/*")
  set(rel "CMakeLists.txt")
  foreach(f IN LISTS inc src)
    list(APPEND rel "${f}")
  endforeach()
  foreach(f IN LISTS tp)
    string(REGEX MATCH "\\.[^./]*$" ext "${f}")
    string(TOLOWER "${ext}" ext)
    if(ext IN_LIST AVAS_THIRD_PARTY_SOURCE_EXT)
      list(APPEND rel "${f}")
    endif()
  endforeach()
  set(kept "")
  foreach(f IN LISTS rel)
    if(NOT f MATCHES "(^|/)\\.")
      list(APPEND kept "${f}")
    endif()
  endforeach()
  list(SORT kept)
  set(abs "")
  foreach(f IN LISTS kept)
    list(APPEND abs "${root}/${f}")
  endforeach()
  set(${out_var} "${abs}" PARENT_SCOPE)
endfunction()

# The hash (64 hex digits).  The sources are text: file(READ) keeps their bytes (a NUL byte would end
# the string, which no source file has).
function(avas_source_hash root out_var)
  avas_hashed_files("${root}" files)
  set(acc "")
  foreach(f IN LISTS files)
    file(RELATIVE_PATH rel "${root}" "${f}")
    file(READ "${f}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(SHA256 h "${content}")
    string(APPEND acc "${rel}\n${h}\n")
  endforeach()
  string(SHA256 total "${acc}")
  set(${out_var} "${total}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE AND DEFINED ROOT AND DEFINED OUT)
  avas_source_hash("${ROOT}" hash)
  set(text "// generated by engine/cmake/source_hash.cmake\n#define AVAS_ENGINE_SOURCE_HASH \"${hash}\"\n")
  set(old "")
  if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
  endif()
  if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
  endif()
endif()
